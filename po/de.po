#: src/main.rs:369
msgid "Watching. Interrupt to leave the sessions recoverable, or:"
msgstr ""
"Wird überwacht. Unterbrechen, um die Sitzungen wiederherstellbar zu lassen, "
"oder:"

#: src/main.rs:441
msgid "No sessions."
msgstr "Keine Sitzungen."

#: src/main.rs:455
msgid "from {container}"
msgstr "aus {container}"

#: src/main.rs:470
msgid "goes back when its container is next opened, or:"
msgstr "geht zurück, wenn sein Container das nächste Mal geöffnet wird, oder:"

#: src/main.rs:509
msgid "Discarded."
msgstr "Verworfen."

#: src/main.rs:517
msgid "Pass --write-back or --discard to act on it."
msgstr "--write-back oder --discard übergeben, um zu handeln."

#: src/main.rs:524
msgid "Written back to {container}."
msgstr "Zurückgeschrieben nach {container}."

#: src/present/mod.rs:288
msgid "Write it back"
msgstr "Zurückschreiben"

#: src/present/mod.rs:289
msgid "Discard it"
msgstr "Verwerfen"

#: src/present/mod.rs:290
msgid "Show me"
msgstr "Zeig es mir"

#: src/recover.rs:118
msgid "nothing was extracted"
msgstr "nichts wurde entpackt"

#: src/recover.rs:119
msgid "unchanged since it came out of the container"
msgstr "unverändert, seit es aus dem Container kam"

#: src/recover.rs:123
msgid "edited, and the edit never reached the container"
msgstr "bearbeitet, und die Änderung erreichte den Container nie"

#: src/recover.rs:128
msgid ""
"edited, and the container changed too, so both hold work the other does not"
msgstr ""
"bearbeitet, und der Container änderte sich ebenfalls, sodass beide Arbeit "
"halten, die der andere nicht hat"

#: src/recover.rs:131
msgid "the container is no longer where it was"
msgstr "der Container ist nicht mehr, wo er war"

#: src/recover.rs:137
msgid "the container now holds {found} rather than {recorded}"
msgstr "der Container hält jetzt {found} statt {recorded}"

#: src/recover.rs:144
msgid "cannot be read: {reason}"
msgstr "kann nicht gelesen werden: {reason}"

#: src/resident.rs:188
msgid "{name} was recovered and written back."
msgstr "{name} wurde wiederhergestellt und zurückgeschrieben."

#: src/resident.rs:191 src/resident.rs:726
msgid "Into {container}."
msgstr "In {container}."

#: src/resident.rs:193
msgid "It had been edited after the session holding it stopped."
msgstr "Es wurde bearbeitet, nachdem die Sitzung, die es hielt, beendet war."

#: src/resident.rs:204 src/resident.rs:646 src/resident.rs:827
msgid "{name} could not be written back."
msgstr "{name} konnte nicht zurückgeschrieben werden."

#: src/resident.rs:296
msgid "{name} is already open; brought forward."
msgstr "{name} ist bereits geöffnet; nach vorn geholt."

#: src/resident.rs:307
msgid "could not bring it forward: {reason}"
msgstr "konnte es nicht nach vorn holen: {reason}"

#: src/resident.rs:346
msgid "{name} was not opened."
msgstr "{name} wurde nicht geöffnet."

#: src/resident.rs:351
msgid "That is the shape of a phishing attachment."
msgstr "Das ist die Form eines Phishing-Anhangs."

#: src/resident.rs:352
msgid "Nothing was extracted and nothing was run."
msgstr "Es wurde nichts entpackt und nichts ausgeführt."

#: src/resident.rs:381
msgid "{name} is open."
msgstr "{name} ist geöffnet."

#: src/resident.rs:382
msgid "Session {id}"
msgstr "Sitzung {id}"

#: src/resident.rs:384
msgid "It came from somewhere else, and the copy says so."
msgstr "Es kam von anderswo, und die Kopie sagt das auch."

#: src/resident.rs:442
msgid "{name} was left behind."
msgstr "{name} wurde zurückgelassen."

#: src/resident.rs:450 src/resident.rs:724
msgid "It is {state}."
msgstr "Es ist {state}."

#: src/resident.rs:452
msgid "From {container}."
msgstr "Aus {container}."

#: src/resident.rs:455
msgid "It will open once you have decided."
msgstr "Es wird geöffnet, sobald Sie entschieden haben."

#: src/resident.rs:627
msgid "{name} written back."
msgstr "{name} zurückgeschrieben."

#: src/resident.rs:630
msgid "Saves from here on are written back quietly."
msgstr "Weitere Speicherungen werden von nun an still zurückgeschrieben."

#: src/resident.rs:720
msgid "{name} was saved after you closed the session."
msgstr "{name} wurde gespeichert, nachdem Sie die Sitzung geschlossen hatten."

#: src/resident.rs:759
msgid "{name} has already been dealt with."
msgstr "{name} wurde bereits erledigt."

#: src/resident.rs:776
msgid "{name} is still waiting."
msgstr "{name} wartet noch."

#: src/resident.rs:783
msgid "The content file is in {folder}"
msgstr "Die Inhaltsdatei liegt in {folder}"

#: src/resident.rs:790
msgid "{folder} could not be shown: {reason}"
msgstr "{folder} konnte nicht gezeigt werden: {reason}"

#: src/resident.rs:809
msgid "{name} written back to {container}."
msgstr "{name} zurückgeschrieben nach {container}."

#: src/resident.rs:840
msgid "{name} discarded."
msgstr "{name} verworfen."

#: src/resident.rs:851
msgid "{name} did not open: {reason}"
msgstr "{name} wurde nicht geöffnet: {reason}"

#: src/resident.rs:877
msgid "{name} is still undecided."
msgstr "{name} ist noch unentschieden."

#: src/resident.rs:906
msgid "a session did not close: {reason}"
msgstr "eine Sitzung wurde nicht geschlossen: {reason}"

#: src/resident.rs:919
msgid "{name} was closed while its application was still working."
msgstr "{name} wurde geschlossen, während seine Anwendung noch arbeitete."

#: src/resident.rs:922
msgid "It is left for recovery: run `slipcase-open sessions`."
msgstr ""
"Es bleibt zur Wiederherstellung liegen: `slipcase-open sessions` ausführen."

#: src/resident.rs:960
msgid "Not opened."
msgstr "Nicht geöffnet."
